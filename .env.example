# Public hostname suffix allocated by the RunPub operator.
RUNPUB_DOMAIN=runpublic.dev

# MVP authentication map. Replace this value and keep the real file private.
RUNPUB_TOKENS_JSON={"keshavmac":"replace-with-a-long-random-token"}

# One-account alternative to RUNPUB_TOKENS_JSON:
# RUNPUB_ALPHA_ACCOUNT=keshavmac
# RUNPUB_ALPHA_TOKEN=replace-with-a-long-random-token

# Public deployments terminate HTTPS at the operator's reverse proxy.
RUNPUB_PUBLIC_SCHEME=https
RUNPUB_PORT=8080

# Required only by the optional Caddy HTTPS profile in deploy/docker-compose.yml.
RUNPUB_TLS_CERT_FILE=/certs/wildcard.crt
RUNPUB_TLS_KEY_FILE=/certs/wildcard.key
