# Public hostname suffix allocated by the RunPublic operator.
RUNPUBLIC_DOMAIN=runpublic.dev

# MVP authentication map. Replace this value and keep the real file private.
RUNPUBLIC_TOKENS_JSON={"keshavmac":"replace-with-a-long-random-token"}

# One-account alternative to RUNPUBLIC_TOKENS_JSON:
# RUNPUBLIC_ALPHA_ACCOUNT=keshavmac
# RUNPUBLIC_ALPHA_TOKEN=replace-with-a-long-random-token

# Public deployments terminate HTTPS at the operator's reverse proxy.
RUNPUBLIC_PUBLIC_SCHEME=https
RUNPUBLIC_PORT=8080

# Required only by the optional Caddy HTTPS profile in deploy/docker-compose.yml.
RUNPUBLIC_TLS_CERT_FILE=/certs/wildcard.crt
RUNPUBLIC_TLS_KEY_FILE=/certs/wildcard.key
